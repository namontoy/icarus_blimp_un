# What git leaves alone in this repo, by kind. Regrouped 2026-10-30 from icarus_blimp_un's list
# and the one DroneUN brought with it on 2026-10-27; every rule of the two is kept, except the
# cflib cache of the esp-drone tools, which left the repo that day.

# --- Build outputs -------------------------------------------------------------------------

# ESP-IDF, for every firmware project, and its resolved dependencies. Persistent configuration
# goes in sdkconfig.defaults* and Kconfig.projbuild; sdkconfig is generated per computer.
build/
managed_components/
dependencies.lock
sdkconfig
sdkconfig.old
# Dated local copies of a generated sdkconfig, kept as a fallback
sdkconfig_*

# Host-side builds of the camera projects' portable code (firmware/projects/*/host/)
firmware/projects/*/host/test_flow_match
firmware/projects/*/host/bias_sweep
firmware/projects/*/host/test_blob_detect
firmware/projects/*/host/test_pipeline
firmware/projects/*/host/test_blob_feat
firmware/projects/*/host/libblob_detect.so

# tools/build.py's host tests and simulator DLL (build/ itself is above)
build_tmp/

# MuJoCo and transient logs
MUJOCO_LOG.TXT
build_log.txt

# --- Python ----------------------------------------------------------------------------------

__pycache__/
*.pyc
# Project-local virtual environment (recreate with: python tools/setup_env.py)
.venv/
venv/
.ruff_cache/
.pytest_cache/
.mypy_cache/
# clangd index, made beside compile_commands.json
.cache/

# --- Data that stays on the computer that made it --------------------------------------------

# Captures fetched from the blimp (blimp_link.py capture, the Bench page)
captures/
# Images collected for training the forward camera's detector
firmware/projects/target_cam/data/
# Third-party papers and documents: 35 MB, re-downloadable; the citations and links are kept in
# docs/reference/README.md and reference/README.md instead
docs/reference/*.pdf
reference/*.pdf
reference/*.txt
# Read-only clone of esp-drone for the reuse task (never committed)
external/esp-drone/
# Task prompts: kept locally, never committed (decided 2026-10-27)
docs/prompts/

# --- Personal ----------------------------------------------------------------------------------

# Per-computer scratch; local/esp-drone-tools/ keeps the esp-drone bench tools on the laptop
# that used them, after they left the repo (2026-10-30)
local/
_scratch/
# Personal Claude Code files (the shared ones are CLAUDE.md and .claude/skills/)
CLAUDE.local.md
.claude/settings.local.json

# --- Editors and operating systems --------------------------------------------------------------

# Per-computer VS Code and ESP-IDF extension settings (the paths differ between computers)
.vscode/
Thumbs.db
desktop.ini
.DS_Store
*.swp
